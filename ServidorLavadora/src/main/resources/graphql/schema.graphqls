type Query {
    lavadoras: [Lavadora]
    lavadoraPorCodigo(codigo: Int!): Lavadora
    lavadoraPorCriterios(codigo: Int, marca: String): Lavadora
    lavadorasPorFiltro(marca: String, tecnologiaInverter: Boolean, conMantenimientos: Boolean): [Lavadora]
    marcasLavadoras: [String!]!
    mantenimientos(codigoLavadora: Int): [Mantenimiento]
    mantenimientoPorId(id: Int!): Mantenimiento
    mantenimientosPorFiltro(codigoLavadora: Int, tecnico: String, completado: Boolean): [Mantenimiento]
    tecnicos(texto: String, especialidad: String, activo: Boolean): [Tecnico]
    tecnicosConLavadoras(texto: String, especialidad: String, activo: Boolean): [TecnicoConLavadora]
    tecnicoPorCodigo(codigo: Int!): Tecnico

    versionDatos: Int!
}

type Mutation {
    addLavadora(input: LavadoraInput!): Lavadora
    actualizarLavadora(codigo: Int!, input: LavadoraUpdateInput!): Lavadora
    eliminarLavadora(codigo: Int!): Boolean

    addMantenimiento(input: MantenimientoInput!): Mantenimiento
    actualizarMantenimiento(id: Int!, input: MantenimientoUpdateInput!): Mantenimiento
    eliminarMantenimiento(id: Int!): Boolean
    addTecnico(input: TecnicoInput!): Tecnico
    actualizarTecnico(codigo: Int!, input: TecnicoInput!): Tecnico
    eliminarTecnico(codigo: Int!): Boolean
}

type Lavadora {
    codigo: Int
    marca: String
    precioBase: Float
    fechaFabricacion: String
    capacidadCargaKilos: Float
    velocidadCentrifugadoRPM: Int
    tecnologiaInverter: Boolean
    minutosLavado: Int
    precioFinal: Float
    mantenimientos: [Mantenimiento]
    cantidadMantenimientos: Int
    mantenimientosPendientes: Int
    costoMantenimientos: Float
}

type Mantenimiento {
    codigoLavadora: Int
    marcaLavadora: String
    id: Int
    descripcion: String
    tecnico: String
    codigoTecnico: Int
    costo: Float
    fecha: String
    completado: Boolean
}

type Tecnico {
    id: String
    codigo: Int
    documento: String
    nombre: String
    especialidad: String
    telefono: String
    fechaIngreso: String
    activo: Boolean
}

type TecnicoConLavadora {
    codigo: Int
    documento: String
    nombre: String
    especialidad: String
    telefono: String
    fechaIngreso: String
    activo: Boolean
    codigoLavadora: Int
    marcaLavadora: String
}

input LavadoraInput {
    codigo: Int!
    marca: String!
    precioBase: Float!
    fechaFabricacion: String!
    capacidadCargaKilos: Float!
    velocidadCentrifugadoRPM: Int!
    tecnologiaInverter: Boolean!
    minutosLavado: Int!
}

input LavadoraUpdateInput {
    marca: String
    precioBase: Float
    fechaFabricacion: String
    capacidadCargaKilos: Float
    velocidadCentrifugadoRPM: Int
    tecnologiaInverter: Boolean
    minutosLavado: Int
}

input MantenimientoInput {
    id: Int!
    codigoLavadora: Int!
    descripcion: String!
    codigoTecnico: Int!
    costo: Float!
    fecha: String!
    completado: Boolean!
}

input MantenimientoUpdateInput {
    descripcion: String
    codigoTecnico: Int
    costo: Float
    fecha: String
    completado: Boolean
}

input TecnicoInput {
    codigo: Int!
    documento: String!
    nombre: String!
    especialidad: String!
    telefono: String!
    fechaIngreso: String!
    activo: Boolean!
}
